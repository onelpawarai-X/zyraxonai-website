# URL reachable only by the ZYRAXON server, not directly by browsers.
ZYRAXON_RUNNER_URL=http://zyraxon-runner:8787

# Shared secret between the ZYRAXON server and runner.
ZYRAXON_RUNNER_SECRET=replace-with-a-long-random-secret

# Runner-side secret. Must match ZYRAXON_RUNNER_SECRET.
RUNNER_SESSION_SECRET=replace-with-a-long-random-secret

RUNNER_PORT=8787
WORKSPACE_ROOT=/workspace
ARTIFACT_ROOT=/workspace/.artifacts
